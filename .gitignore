# Build outputs
build/
build-*/
out/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Vendored open-source code is fetched by scripts/fetch-vendor.sh (pinned in vendor/MANIFEST.tsv)
# We track the manifest + docs but not the source — keeps repo small and provenance reproducible.
vendor/*/
!vendor/MANIFEST.tsv
!vendor/README.md

# Editor / OS / LSP / agent state
.DS_Store
.idea/
.vscode/
.cache/
.claude/
compile_commands.json
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/
venv/

# Generated test audio (regenerate locally; don't commit large WAVs)
reference/synth/
*.wav
*.ogg
*.mp3
*.flac
*.aac
!reference/README.md
!reference/**/*.md
# AEC-Challenge subset: WAVs gitignored (caught by *.wav), MANIFEST.tsv tracked
!datasets/**/MANIFEST.tsv
# vehicle_noise corpus: 130 MB TCAR zip cache never belongs in git;
# the fetched ITU license text IS tracked for provenance.
datasets/vehicle_noise/.cache/
!datasets/vehicle_noise/p501/itu_license_text_from_P501.txt
!reference/noise/MANIFEST.tsv

# Models — large binaries; commit pointers, not weights
models/*.tflite
models/*.onnx
models/*.pb
models/*.bin

# Coverage / profiling
*.gcda
*.gcno
*.profraw
coverage/

# CTest
Testing/

# GB/T 45314 eCall gate conditions — generated by reference/gen_gbt45314_ecall_conditions.py
conditions/
